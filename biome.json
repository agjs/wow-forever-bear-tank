{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/**",
      "tools/**",
      "apps/web/**",
      "*.json",
      "*.ts",
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!apps/web/public"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "error", "noNonNullAssertion": "error" },
      "suspicious": { "noExplicitAny": "error" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
